/**************************************************************
Sakuhin Caption...
ダイヤ柄と花を掛け合わせてみました
quadをメインに制作した
大きさや色、間隔は固定
 **************************************************************/
size(500, 500);      // ウィンドウの幅　高さ　
background(62,64,75 );  // 背景 色　灰色

pushMatrix();

for (int iX=0; iX<5; iX++)
{
  strokeWeight( 8 );
  stroke( 0, 8, 58 );  //直線の色　青
  line( -375, 0, 125, 500 );  //直線 左上がり　
  line( -375, 500, 125, 0 );  //直線　右上がり

  noStroke();  //輪郭線　なし

  fill(0, 8, 58); //色指定　青
  quad(-100, 0, 0, -100, 100, 0, 0, 100);  //１段目ひし形
  quad(-100, 250, 0, 150, 100, 250, 0, 350);  //３段目ひし形
  quad(-100, 500, 0, 400, 100, 500, 0, 600);  //５段目ひし形
 //fill(21, 153, 200);  //色指定　緑
  fill(150,162,104);
  quad(25, 125, 125, 25, 225, 125, 125, 225);  //２段目ひし形
  quad(25, 375, 125, 275, 225, 375, 125, 475);  //４段目ひし形
 
 //１段目ひし形　花
   fill( 193,200,225,15); //濃い　花
 quad(-100, 0, -75, -25, 0, 0, -75, 25);  //花　左
 quad(0, 0, 75, -25, 100, 0, 75, 25);  //花　右
   quad(-25, 75, 0, 0, 25, 75, 0, 100);  //花　下
 
 fill( 174,183,193,20);  //薄い　花
  quad(-50, 50, -50, 25, 0, 0, -25, 50);  //花　左下
   quad(0, 0, 50, 25, 50, 50, 25, 50);  //花　右下
  
  //２段目ひし形　花
  fill(193,193,174,140); //濃い　花
 quad(25, 125, 50, 100, 125, 125, 50, 150);  //花　左
 quad(125, 125, 200, 100, 225, 125, 200, 150);  //花　右
  quad(100, 50, 125, 25, 150, 50, 125, 125);  //花　上
   quad(100, 200, 125, 125, 150, 200, 125, 225);  //花　下
 rect(112.5,115,25,20,45);  //　花　真ん中　四角形
 
fill( 214,214,205,50);  //薄い　花
  quad(75, 75, 100, 75, 125, 125, 75, 100);  //花　左上
 quad(125, 125, 150, 75, 175, 75, 175, 100);  //花　右上
  quad(125, 125, 175, 150, 175, 175, 150, 175);  //花　左下
   quad(75, 175, 75, 150, 125, 125, 100, 175);  //花　右下
 rect(112.5,115,25,20,45);  //　花　真ん中　四角形
 
 //３段目ひし形　花
   fill( 193,200,225,15); //濃い　花
 quad(-100, 250, -75, 225, 0, 250, -75, 275);  //花　左
  quad(0, 250, 75, 225, 100, 250, 75, 275);  //花　右
  quad(-25, 175, 0, 150, 25, 175, 0, 250);  //花　上
   quad(-25, 325, 0, 250, 25, 325, 0, 350);  //花　下
 rect(-12.5,240,25,20,45);  //　花　真ん中　四角形
 
 fill( 174,183,193,20);  //薄い　花
 quad(-50, 225, -50, 200, -25, 200, 0, 250);  //花　左上
 quad(0, 250, 25, 200, 50, 200, 50, 225);  //花　右上
  quad(0, 250, 50, 275, 50, 300, 25, 300);  //花　左下
   quad(-50, 300, -50, 275, 0, 250, -25, 300);  //花　右下
 rect(-12.5,240,25,20,45);  //　花　真ん中　四角形
 
 //４段目ひし形　花
  fill(193,193,174,140); //濃い　花
 quad(25, 375, 50, 350, 125, 375, 50, 400);  //花　左
 quad(100, 300, 125, 275, 150, 300, 125, 375);  //花　右
  quad(125, 375, 200, 350, 225, 375, 200, 400);  //花　上
   quad(100, 450, 125, 375, 150, 450, 125, 475);  //花　下
 rect(112.5,365,25,20,45);  //　花　真ん中　四角形
 
fill( 214,214,205,50);  //薄い　花
  quad(75, 325, 100, 325, 125, 375, 75, 350);  //花　左上
 quad(125, 375, 150, 325, 175, 325, 175, 350);  //花　右上
  quad(75, 425, 75, 400, 125, 375, 100, 425);  //花　左下
   quad(125, 375, 150, 400, 175, 425, 150, 425);  //花　右下
rect(112.5,365,25,20,45);  //　花　真ん中　四角形
 
 //５段目ひし形　花
   fill( 193,200,225,15); //濃い　花
 quad(-100, 500, -75, 475, 0, 500, -75, 575);  //花　左
  quad(-25, 425, 0, 400, 25, 425, 0, 500);  //花　上
  quad(0, 500, 75, 475, 100, 500, 75, 525);  //花　右
 
 fill( 174,183,193,20);  //薄い　花
 quad(-50, 475, -50, 450, -25, 450, 0, 500);  //花　左上
 quad(0, 500, 25, 450, 50, 450, 50, 475);  //花　右上
 
 translate( 250, 0);  //平行移動させる
}

popMatrix();

for (int iX=0; iX<5; iX++)

{
  strokeWeight( 8 );  //線　幅
  stroke( 209,212,219,150 );  //直線の色　透明
  line( -250, 0, 250, 500 );  //直線 左上がり　
  line( -250, 500, 250, 0 );  //直線　右上がり
  
  noStroke();  //輪郭線　なし
  fill(iX,255);  //白いひし形
 fill(209,212,219,100);  //白いひし形色　透明
 quad(-100, 125, 0, 25, 100, 125, 0, 225);  //１段目ひし形
 quad(-100, 375, 0, 275, 100, 375, 0, 475);  //２段目ひし形

  translate( 250, 0);  //平行移動させる

}


