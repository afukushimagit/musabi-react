/**************************************************************
ドット絵の情報を格納した3次元配列と、数値に対する色の情報を格納した2次元配列をもとにドット絵を描画する。
人の指を模っている。
 **************************************************************/
void setup()
{
  size(700, 170);
  colorMode(HSB, 255, 100, 100, 100);
  background(40);
  noStroke();
  frameRate(1);
}

void draw()
{
  //時間を2桁にする。(ChatGPTを活用)　例)3→03
  String houStr = nf(hour(), 2);
  String minStr = nf(minute(), 2);
  String secStr = nf(second(), 2);

  //描画リセット
  translate(10, 10);
  background(40);
  //時×2桁、分×2桁、秒×2桁のドット絵を表示。
  drawHand(0, int(houStr.charAt(0)) - int('0'));
  drawHand(110, int(houStr.charAt(1)) - int('0'));
  drawHand(230, int(minStr.charAt(0)) - int('0'));
  drawHand(340, int(minStr.charAt(1)) - int('0'));
  drawHand(460, int(secStr.charAt(0)) - int('0'));
  drawHand(570, int(secStr.charAt(1)) - int('0'));
}
